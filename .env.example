# Copy thành .env và điền giá trị thật (.env đã được gitignore)
# Backend đọc cấu hình trong backend/src/chatbot_haui/core/config.py

# --- Bảo mật: chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng: openssl rand -hex 32 ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL (scripts/init_db.py chạy trên máy dùng DB_HOST/DB_PORT này; compose mở Postgres ra DB_PORT) ---
# DB_USER là owner: tạo schema core/private/chatbot, bảng, view. Backend dùng nó cho auth và API sinh viên.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=CSDLDoAnCN
# Role riêng cho Text2SQL: chỉ SELECT trên schema chatbot, statement_timeout 5s
DB_CHATBOT_USER=chatbot_app
DB_CHATBOT_PASSWORD=

# --- LLM: google | groq. Model chính (Planner, Text2SQL, Generator, Validator) ---
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model nhỏ (Rewriter, Router, RAG judge, trích xuất memory, tóm tắt) — provider riêng để chia quota;
# để trống = cùng provider với model chính
LLM_PROVIDER_SMALL=groq
LLM_MODEL_SMALL=openai/gpt-oss-20b

# --- Retrieval ---
QDRANT_URL=
QDRANT_API_KEY=
# Collection văn bản quy chế (hybrid: dense bge-m3 + sparse BM25), do scripts/ingest.py tạo
QDRANT_COLLECTION=haui_quy_che_hybrid
QDRANT_MEMORY_COLLECTION=haui_chatbot_memory
COHERE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RAG_PRELOAD=true
# Ngày chốt dữ liệu nêu trong câu trả lời (dữ liệu mẫu chốt 31/08/2026); để trống = hôm nay
DATA_AS_OF=


# --- Docker ---
APP_PORT=8080
WEB_CONCURRENCY=1

# --- Bộ nhớ dài hạn (Mem0 OSS chạy in-process, vector store là Qdrant) ---
# Khóa băm ma_sv trước khi gửi lên cloud: openssl rand -hex 32
MEMORY_SALT=
MEMORY_ENABLED=true

# --- Langfuse ---
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
