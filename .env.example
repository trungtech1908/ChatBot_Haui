# Copy thành .env và điền giá trị thật (.env đã được gitignore)
# Backend đọc cấu hình trong backend/src/chatbot_haui/core/config.py

# --- Bảo mật: chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng: openssl rand -hex 32 ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=CSDLDoAnCN

# --- LLM: google | groq ---
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Retrieval ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=RAG_ChatBot_HAUI
COHERE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RAG_PRELOAD=true

# --- Docker ---
APP_PORT=8080
WEB_CONCURRENCY=1
